@startuml 02-class-diagram
!pragma layout smetana
!include _style.iuml
skinparam classFontSize 12
skinparam classAttributeFontSize 10
skinparam packageFontStyle bold
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 45
hide empty methods
hide circle

title SYNAPSE — Domain Class Diagram (all 37 Eloquent models, backend/app/Models)

' =====================================================================
package "Tenancy & Billing" as PKG_TENANCY <<Frame>> {
  class School {
    - id : int
    - name : string
    - slug : string {unique}
    - code : string {unique}
    - email : string
    - phone : string
    - address : string
    - logo : text
    - status : enum {active, trial, suspended, expired}
    - timezone : string = "Africa/Douala"
    - primary_color : string
    - subscription_plan_id : int
    - subscription_status : string
    - subscription_started_at : datetime
    - subscription_expires_at : datetime
    + isActive() : bool
    + setting(key, default) : mixed
    + setSetting(key, value) : void
  }
  class SchoolSetting {
    - id : int
    - school_id : int
    - key : string
    - value : text
  }
  class SubscriptionPlan {
    - id : int
    - name : string
    - slug : string {unique}
    - description : text
    - price : decimal(12,2)
    - billing_interval : enum {monthly, yearly}
    - currency : string = "XAF"
    - max_students : int
    - max_teachers : int
    - max_classes : int
    - features : json
    - status : enum {active, archived}
    + hasFeature(feature) : bool
  }
  class Subscription {
    - id : int
    - school_id : int
    - plan_id : int
    - status : enum {trial, active, past_due,\n   cancelled, expired, suspended}
    - start_date : date
    - end_date : date
    - billing_interval : string
    - amount : decimal(12,2)
    - currency : string
    + isActive() : bool
  }
  class Payment {
    - id : int
    - school_id : int
    - subscription_id : int
    - provider : enum {mock, mtn_momo, orange_money, card}
    - method : string
    - amount : decimal(12,2)
    - currency : string
    - status : enum {pending, succeeded, failed, refunded}
    - reference : string {unique}
    - metadata : json
    - sandbox : bool
    - paid_at : datetime
  }
  class AuditLog {
    - id : int
    - school_id : int
    - user_id : int
    - action : string
    - entity_type : string
    - entity_id : int
    - metadata : json
    - created_at : datetime
  }
}

' =====================================================================
package "People & Access" as PKG_PEOPLE <<Frame>> {
  class User {
    - id : int
    - school_id : int
    - name : string
    - email : string {unique}
    - phone : string
    - password : string
    - role : enum {super_admin, admin, teacher, student}
    - must_change_password : bool
    - password_changed_at : datetime
    - last_login_at : datetime
    - notify_email : bool = true
    - notify_sms : bool = false
    - locale : string = "en"
    + isSuperAdmin() : bool
    + isAdmin() : bool
    + isTeacher() : bool
    + isStudent() : bool
    + routeNotificationForSms() : string
  }
  class PersonalAccessToken <<Sanctum>> {
    - id : int
    - tokenable_type : string
    - tokenable_id : int
    - name : string
    - token : string {unique, sha256}
    - abilities : text
    - last_used_at : datetime
    - expires_at : datetime
  }
  class Student {
    - id : int
    - school_id : int
    - user_id : int
    - matricule : string {unique}
  }
  class Teacher {
    - id : int
    - school_id : int
    - user_id : int
    - staff_no : string {unique}
  }
  class Notification {
    - id : int
    - school_id : int
    - user_id : int
    - type : string
    - title : string
    - message : text
    - data : json
    - read_at : datetime
    + markAsRead() : void
  }
}

' =====================================================================
package "Academic Structure" as PKG_ACADEMIC <<Frame>> {
  class AcademicYear {
    - id : int
    - school_id : int
    - name : string
    - start_date : date
    - end_date : date
    - is_current : bool
    + {static} current() : AcademicYear
  }
  class Semester {
    - id : int
    - school_id : int
    - academic_year_id : int
    - name : string
    - sequence : int
    - start_date : date
    - end_date : date
    - is_current : bool
    + {static} current() : Semester
  }
  class SchoolClass {
    - id : int
    - school_id : int
    - name : string
  }
  class Subject {
    - id : int
    - school_id : int
    - name : string
    - code : string
  }
  class Enrollment {
    - id : int
    - school_id : int
    - student_id : int
    - class_id : int
    - academic_year_id : int
  }
  class TeachingAssignment {
    - id : int
    - school_id : int
    - teacher_id : int
    - subject_id : int
    - class_id : int
    - academic_year_id : int
  }
  class TimetableEntry {
    - id : int
    - school_id : int
    - class_id : int
    - academic_year_id : int
    - subject_id : int
    - day : int (1..7)
    - start : time
    - end : time
  }
  class Exam {
    - id : int
    - school_id : int
    - academic_year_id : int
    - semester_id : int
    - subject_id : int
    - class_id : int
    - date : date
    - start : time
    - end : time
    - room : string
  }
}

