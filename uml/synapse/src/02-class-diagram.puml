' =====================================================================
package "Documents" as PKG_DOCS <<Frame>> {
  class DocumentRequest {
    - id : int
    - school_id : int
    - student_id : int
    - reference : string {unique, REQ-####}
    - type : string
    - reason : text
    - status : enum {submitted, under_review,\n   approved, ready, rejected}
