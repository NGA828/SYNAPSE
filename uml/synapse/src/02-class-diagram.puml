    - size : int
    - disk : string
    - path : string
    - verification_code : string {unique}
    - meta : json
  }
}

' =====================================================================
package "Learning" as PKG_LEARN <<Frame>> {
  interface HasAttachments <<App\\Contracts>> {
    + attachments() : MorphMany
    + ownedByTeacher(teacher) : bool
    + readableByStudent(student) : bool
  }
  class HomeworkAssignment {
    - id : int
    - school_id : int
    - teacher_id : int
    - subject_id : int
    - class_id : int
    - academic_year_id : int
    - semester_id : int
    - title : string
    - instructions : text
    - max_score : int = 20
    - due_at : datetime
    - is_published : bool
    - published_at : datetime
    + isPastDue() : bool
    + isOpenForSubmission() : bool
  }
  class HomeworkSubmission {
    - id : int
    - school_id : int
    - homework_assignment_id : int
    - student_id : int
    - content : text
    - attempts : int = 1
    - submitted_at : datetime
    - is_late : bool
    - score : decimal(6,2)
    - feedback : text
    - graded_by : int
    - graded_at : datetime
    - returned_at : datetime
    + isGraded() : bool
    + status() : enum {submitted, late, graded}
  }
  class Lesson {
    - id : int
    - school_id : int
    - teacher_id : int
    - subject_id : int
    - class_id : int
    - academic_year_id : int
    - semester_id : int
    - title : string
    - topic : string
    - summary : text
    - body : longtext
    - minutes : int
    - sequence : int
    - is_published : bool
    - published_at : datetime
  }
  class Quiz {
    - id : int
    - school_id : int
    - teacher_id : int
    - subject_id : int
    - class_id : int
    - academic_year_id : int
    - semester_id : int
    - title : string
    - instructions : text
    - max_score : int = 20
    - closes_at : datetime
    - time_limit_minutes : int
    - attempts_allowed : int = 1
    - is_published : bool
    - is_locked : bool
    + pointsAvailable() : int
    + isOpen() : bool
  }
  class QuizQuestion {
    - id : int
    - school_id : int
    - quiz_id : int
    - prompt : text
    - options : json
    - correct_option : int
    - points : int = 1
    - sequence : int
    + isCorrect(option) : bool
  }
  class QuizAttempt {
    - id : int
    - school_id : int
    - quiz_id : int
    - student_id : int
    - answers : json
    - correct_count : int
    - total_questions : int
    - score : decimal(5,2)
    - attempt : int
    - started_at : datetime
    - submitted_at : datetime
    - feedback : text
    - is_reviewed : bool
    - reviewed_by : int
    + percentage() : float
  }
  class Attachment {
    - id : int
    - school_id : int
    - attachable_type : string
    - attachable_id : int
    - uploaded_by_role : enum {teacher, student}
    - uploaded_by : int
    - file_name : string
    - mime_type : string
    - size : int
    - disk : string = "local"
    - path : string
    - visibility : enum {class, private}
    + isPrivate() : bool
    + humanSize() : string
  }
}

